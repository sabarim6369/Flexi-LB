# FlexiLB MCP Server Configuration

# Main FlexiLB Server URL
FLEXILB_API_URL=http://localhost:3000

# Authentication token (if needed for API calls)
# This should be the same JWT token used by the main FlexiLB application
FLEXILB_API_TOKEN=your_auth_token_here

# MCP Server Configuration
MCP_SERVER_PORT=4000
MCP_SERVER_HOST=localhost

# Enable CORS for development
CORS_ENABLED=true